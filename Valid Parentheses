class Solution {
    public boolean isValid(String s) {
        Stack<Character> stack = new Stack<>();

        for(int i = 0; i<s.length(); i++){

            char ch = s.charAt(i);
            if(stack.isEmpty()) {
                stack.push(ch);
                continue;
            }
            if(ch == ')')
            {
                if(stack.peek() == '(')
                    stack.pop();
                else    
                    break;

            }else if(ch == ']')
            {
                if(stack.peek() == '[')
                    stack.pop();
                 else    
                    break;                   

            }else if(ch == '}')
            {
                if(stack.peek() == '{')
                    stack.pop();
                else    
                    break;
            }else{
                stack.push(ch);
            }
                 
        }
        if(stack.isEmpty())
            return true;

        return false;
    }
}
